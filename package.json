{
  "name": "kindee",
  "private": true,
  "version": "0.6.0",
  "description": "กินดี (KinDee) - แอปนับแคลอรี่และสุขภาพ ฟรี 100% โอเพนซอร์ส เก็บข้อมูลในเครื่อง",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "build:embed": "tsc --noEmit && vite build -c vite.embed.config.ts",
    "build:portable": "tsc --noEmit && vite build -c vite.portable.config.ts && node scripts/make-portable.mjs",
    "e2e:portable": "node e2e/portable.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "android:sync": "npm run build:portable && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "ios:sync": "npm run build:portable && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "build:cloudmock": "tsc --noEmit && vite build --mode cloudmock --outDir dist-cloudmock"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@zxing/library": "^0.21.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwip-js": "^4.11.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
